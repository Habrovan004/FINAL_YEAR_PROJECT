# ──────────────────────────────────────────────────────────────────────
# Mimba Yangu / Uzazi Safe Link — backend environment template
# Copy to backend/.env and fill in the real values for your environment.
# ──────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=replace-me-with-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=mimba_yangu
DB_USER=mimba_yangu_app
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Africa's Talking (SMS / OTP)
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_key_here

# Email OTP (Gmail SMTP shown — substitute your own provider)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Mimba Yangu <your@gmail.com>

# Google Gemini (Health Assistant)
# Get a key at https://aistudio.google.com/app/apikey.
# Until set, the chat returns a friendly "service unavailable" message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# How many prior turns to feed the model (covers ~10 user/assistant pairs)
AI_CHAT_HISTORY_LIMIT=20
